      "pluginVersion": "12.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "label_replace(max by (id, name, type, node, tags) (pve_guest_info{cluster=~\"$cluster\", node=~\"$node\"}), \"vmid\", \"$1\", \"id\", \"(?:qemu|lxc)/(.*)\")",
          "format": "table",
          "instant": true,
          "refId": "guest_info"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (pve_up{cluster=~\"$cluster\"} and on (id, instance) pve_guest_info{node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "status"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (pve_cpu_usage_limit{cluster=~\"$cluster\"} and on (id, instance) pve_guest_info{node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "vcpus"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (avg_over_time(pve_cpu_usage_ratio{cluster=~\"$cluster\"}[5m]) and on (id, instance) pve_guest_info{node=~\"$node\"} and on (id) pve_up == 1)",
          "format": "table",
          "instant": true,
          "refId": "cpu_pct"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (pve_memory_size_bytes{cluster=~\"$cluster\"} and on (id, instance) pve_guest_info{node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "memsize"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (pve_memory_usage_bytes{cluster=~\"$cluster\"} / pve_memory_size_bytes and on (id, instance) pve_guest_info{node=~\"$node\"} and on (id) pve_up == 1)",
          "format": "table",
          "instant": true,
          "refId": "mem_pct"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (pve_disk_size_bytes{cluster=~\"$cluster\"} and on (id, instance) pve_guest_info{node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "disksize"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (pve_disk_usage_bytes{cluster=~\"$cluster\"} / pve_disk_size_bytes and on (id, instance) pve_guest_info{type=\"lxc\", node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "disk_pct"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (pve_uptime_seconds{cluster=~\"$cluster\"} and on (id, instance) pve_guest_info{node=~\"$node\"} and on (id) pve_up == 1)",
          "format": "table",
          "instant": true,
          "refId": "uptime"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (rate(pve_network_receive_bytes{cluster=~\"$cluster\"}[5m]) and on (id, instance) pve_guest_info{node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "net_in"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (rate(pve_network_transmit_bytes{cluster=~\"$cluster\"}[5m]) and on (id, instance) pve_guest_info{node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "net_out"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (rate(pve_disk_read_bytes{cluster=~\"$cluster\"}[5m]) and on (id, instance) pve_guest_info{node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "disk_read"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (id) (rate(pve_disk_write_bytes{cluster=~\"$cluster\"}[5m]) and on (id, instance) pve_guest_info{node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "disk_write"
        }
      ],
      "title": "All Guests",
