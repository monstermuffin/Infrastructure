    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "id": 15,
      "title": "Network throughput",
      "description": "Receive (up) and transmit (down) per interface; bridges and virtual interfaces are not collected.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "rate(node_network_receive_bytes_total{job=\"node_fast\", site=~\"$site\", host=~\"$host\"}[$__rate_interval])",
          "legendFormat": "rx {{device}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "-rate(node_network_transmit_bytes_total{job=\"node_fast\", site=~\"$site\", host=~\"$host\"}[$__rate_interval])",
          "legendFormat": "tx {{device}}",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
