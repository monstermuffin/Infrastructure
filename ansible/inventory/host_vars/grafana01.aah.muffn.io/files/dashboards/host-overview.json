          },
          "editorMode": "code",
          "expr": "node_load1{job=\"node_fast\", site=~\"$site\", host=~\"$host\"}",
          "legendFormat": "1m",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "node_load5{job=\"node_fast\", site=~\"$site\", host=~\"$host\"}",
          "legendFormat": "5m",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "node_load15{job=\"node_fast\", site=~\"$site\", host=~\"$host\"}",
          "legendFormat": "15m",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "count(node_cpu_seconds_total{job=\"node_fast\", mode=\"idle\", site=~\"$site\", host=~\"$host\"})",
          "legendFormat": "cores",
          "range": true,
          "refId": "D"
