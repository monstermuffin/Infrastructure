    {
      "id": 11,
      "type": "row",
      "title": "Memory and pressure",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "id": 12,
      "title": "Memory by service",
      "description": "Working set per systemd service, plus the rest of the used memory (kernel, cache and anything not in a service). Hosts without unit metrics show only the total. The dashed Proxmox view is what Proxmox reports for the guest: for containers it lands within about 10% of the in-guest figure, for VMs it includes the guest page cache and sits far above it. Canonical unit:, host: and guest: series.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "unit:memory_bytes{site=~\"$site\", host=~\"$host\"}",
          "legendFormat": "{{unit}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "host:memory_used_bytes{site=~\"$site\", host=~\"$host\"} - (sum(unit:memory_bytes{site=~\"$site\", host=~\"$host\"}) or vector(0))",
          "legendFormat": "other (kernel, cache, unaccounted)",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "host:memory_total_bytes{site=~\"$site\", host=~\"$host\"}",
          "legendFormat": "total",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "guest:memory_bytes{site=~\"$site\", host=~\"$host\"}",
          "legendFormat": "Proxmox view",
          "range": true,
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "total|Proxmox view"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "id": 13,
      "title": "Pressure",
      "description": "Share of time tasks were stalled waiting for a resource (some, not full). Sustained values mean contention even when usage looks fine.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
