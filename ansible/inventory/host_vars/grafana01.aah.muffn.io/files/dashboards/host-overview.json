          },
          "editorMode": "code",
          "expr": "rate(node_pressure_cpu_waiting_seconds_total{job=\"node_fast\", site=~\"$site\", host=~\"$host\"}[$__rate_interval])",
          "legendFormat": "cpu",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "rate(node_pressure_memory_waiting_seconds_total{job=\"node_fast\", site=~\"$site\", host=~\"$host\"}[$__rate_interval])",
          "legendFormat": "memory",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "rate(node_pressure_io_waiting_seconds_total{job=\"node_fast\", site=~\"$site\", host=~\"$host\"}[$__rate_interval])",
          "legendFormat": "io",
          "range": true,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Network and storage",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
