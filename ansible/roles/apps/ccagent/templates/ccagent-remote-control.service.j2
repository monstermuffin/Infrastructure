[Unit]
Description=CC-RC ({{ ccagent_user }})
After=network-online.target
Wants=network-online.target
# Reset with: sudo systemctl reset-failed {{ ccagent_service_name }}
# Re-authenticate with: sudo ccagent-relogin
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User={{ ccagent_user }}
Group={{ ccagent_user }}
Environment=HOME={{ ccagent_home }}
Environment=PATH={{ ccagent_home }}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-{{ ccagent_home }}/.env
{% if ccagent_infisical_enabled | bool %}
RuntimeDirectory=ccagent-secrets
RuntimeDirectoryMode=0700
ExecStartPre={{ ccagent_home }}/.local/bin/ccagent-fetch-secrets.sh
{% endif %}
WorkingDirectory={{ ccagent_workdir }}
ExecStart=/bin/sh -c 'echo y | exec {{ ccagent_bin }} remote-control --name "{{ ccagent_remote_control_name }}"{{ (' --spawn ' ~ ccagent_remote_control_spawn) if ccagent_remote_control_spawn | length > 0 else '' }}'
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
